/// Perdes payung kerja sama desa — satu baris per desa, diunggah sekali.
/// Berkasnya tidak disimpan di sini; produk_hukum_id menunjuk ke modul Produk
/// Hukum Desa supaya dokumen yang sama tidak terunggah dua kali di dua menu.
model kerjasama_desa_legalitas {
  id              BigInt         @id @default(autoincrement())
  desa_id         BigInt         @unique(map: "kerjasama_desa_legalitas_desa_unique")
  nomor_perdes    String? @db.Citext
  tahun_perdes    Int?
  produk_hukum_id String? @db.Citext
  keterangan      String? @db.Citext
  created_by      BigInt?
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  desas           desas          @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_kerjasama_legalitas_desa")
  produk_hukums   produk_hukums? @relation(fields: [produk_hukum_id], references: [id], map: "fk_kerjasama_legalitas_produk_hukum")

  @@index([produk_hukum_id], map: "kerjasama_desa_legalitas_produk_hukum_index")
}

/// Satu kegiatan kerja sama desa. Banyak baris per desa, tanpa batas jumlah.
model kerjasama_desa {
  id              BigInt                @id @default(autoincrement())
  desa_id         BigInt
  tahun           Int
  jenis           kerjasama_desa_jenis
  bidang          kerjasama_desa_bidang
  sub_bidang      String? @db.Citext
  mitra           String @db.Citext
  ruang_lingkup   String? @db.Citext
  tanggal_mulai   DateTime? @db.Date
  tanggal_selesai DateTime? @db.Date
  file_permakades String? @db.Citext
  file_sk_bkd     String? @db.Citext
  file_pks_mou    String? @db.Citext
  pelaksanaan     String? @db.Citext
  created_by      BigInt?
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  desas           desas                 @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_kerjasama_desa_desa")

  @@index([desa_id, tahun], map: "kerjasama_desa_desa_tahun_index")
  @@index([bidang], map: "kerjasama_desa_bidang_index")
  @@index([jenis], map: "kerjasama_desa_jenis_index")
}

enum kerjasama_desa_jenis {
  antar_desa
  pihak_ketiga
}

enum kerjasama_desa_bidang {
  penyelenggaraan_pemerintahan
  pelaksanaan_pembangunan
  pembinaan_kemasyarakatan
  pemberdayaan_masyarakat
}

// -----------------------------------------------------------------------------
// SMART CCTV — modul pengawasan kamera terpadu super app.
// Sumber kebenaran kamera & peristiwa deteksi (wajah, jatuh) berpindah ke
// sini dari dashboard Laravel; layanan AI (Facial-recognition-cctv) dan
// go2rtc tetap menjadi pelaku teknis di baliknya.
// -----------------------------------------------------------------------------

enum cctv_camera_status {
  active
  inactive
  maintenance
  offline
}

enum cctv_event_type {
  known
  unknown
  fall
  fall_warning
  immobility
  other
  person
}

enum cctv_event_severity {
  info
  warning
  critical
}

enum cctv_event_status {
  active
  acknowledged
  resolved
}

/// Satu unit kamera. Kredensial RTSP disimpan terenkripsi (lihat utils/cctvSecret)
/// dan hanya diurai mentah saat dilayani ke layanan AI / go2rtc.
model cctv_cameras {
  id                     BigInt             @id @default(autoincrement())
  name                   String @db.Citext
  lokasi                 String? @db.Citext
  rtsp_url               String @db.Citext
  rtsp_url_main          String? @db.Citext
  rtsp_url_sub           String? @db.Citext
  username               String? @db.Citext
  password_enc           String? @db.Citext
  desa_id                BigInt?
  kecamatan_id           BigInt?
  status                 cctv_camera_status @default(inactive)
  recognition_enabled    Boolean            @default(true)
  fall_detection_enabled Boolean            @default(true)
  go2rtc_src             String?            @unique @db.Citext
  last_online_at         DateTime? @db.Timestamp(0)
  zona                   Json?
  jam_pantau             Json?
  created_by             BigInt?
  created_at             DateTime?          @default(now()) @db.Timestamp(0)
  updated_at             DateTime?          @default(now()) @db.Timestamp(0)
  events                 cctv_events[]

  @@index([status], map: "idx_cctv_cameras_status")
  @@index([desa_id], map: "idx_cctv_cameras_desa")
  @@index([kecamatan_id], map: "idx_cctv_cameras_kecamatan")
}

/// Wajah yang dikenali layanan AI: hasil impor data lama maupun enrollment baru
/// dari super app. Dipasok ke layanan AI lewat endpoint kompatibel "face-embeddings".
model cctv_faces {
  id           BigInt                 @id @default(autoincrement())
  nama         String @db.Citext
  kode_pegawai String? @db.Citext
  departemen   String? @db.Citext
  foto_path    String? @db.Citext
  created_by   BigInt?
  created_at   DateTime?              @default(now()) @db.Timestamp(0)
  updated_at   DateTime?              @default(now()) @db.Timestamp(0)
  embeddings   cctv_face_embeddings[]
  events       cctv_events[]

  @@index([nama], map: "idx_cctv_faces_nama")
  @@index([kode_pegawai], map: "idx_cctv_faces_kode")
}

/// Satu foto embedding milik satu wajah (mirip employee_photos di dashboard lama).
model cctv_face_embeddings {
  id         BigInt     @id @default(autoincrement())
  face_id    BigInt
  image_path String @db.Citext
  embedding  Json
  created_at DateTime?  @default(now()) @db.Timestamp(0)
  face       cctv_faces @relation(fields: [face_id], references: [id], onDelete: Cascade, map: "fk_cctv_face_embeddings_face")

  @@index([face_id], map: "idx_cctv_face_embeddings_face")
}

/// Satu peristiwa deteksi (wajah dikenal/tidak dikenal, jatuh, dsb).
/// Idempoten pada event_uuid: kiriman ulang dari layanan AI tidak menggandakan data.
model cctv_events {
  id              BigInt              @id @default(autoincrement())
  event_uuid      String              @unique @db.Citext
  camera_id       BigInt
  type            cctv_event_type
  severity        cctv_event_severity @default(info)
  face_id         BigInt?
  nama            String? @db.Citext
  similarity      Float?
  confidence      Float?
  bbox            Json?
  track_id        String? @db.Citext
  snapshot_path   String? @db.Citext
  status          cctv_event_status   @default(active)
  metadata        Json?
  acknowledged_by BigInt?
  acknowledged_at DateTime? @db.Timestamp(0)
  occurred_at     DateTime @db.Timestamp(0)
  created_at      DateTime?           @default(now()) @db.Timestamp(0)
  camera          cctv_cameras        @relation(fields: [camera_id], references: [id], onDelete: Cascade, map: "fk_cctv_events_camera")
  face            cctv_faces?         @relation(fields: [face_id], references: [id], onDelete: SetNull, map: "fk_cctv_events_face")

  @@index([camera_id, occurred_at], map: "idx_cctv_events_camera_time")
  @@index([occurred_at], map: "idx_cctv_events_time")
  @@index([status], map: "idx_cctv_events_status")
  @@index([type], map: "idx_cctv_events_type")
  @@index([severity], map: "idx_cctv_events_severity")
}

/// Hari libur nasional / cuti bersama (tanggal merah). updated_at diisi trigger trg_hari_libur_updated_at.
model hari_libur {
  id         Int       @id @default(autoincrement())
  tanggal    DateTime  @unique(map: "uq_hari_libur_tanggal") @db.Date
  keterangan String    @db.Citext
  is_active  Boolean   @default(true)
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model migration_history {
  id       Int      @id @default(autoincrement())
  filename String   @unique(map: "filename") @db.Citext
  ran_at   DateTime @default(now()) @db.Timestamp(0)

  @@map("_migration_history")
}

model event_attendance_settings {
  id         BigInt    @id @default(autoincrement())
  event_code String    @unique(map: "event_code") @db.Citext
  event_name String    @db.Citext
  event_date DateTime? @db.Date
  location   String?   @db.Citext
  qr_payload String    @db.Citext
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model event_attendances {
  id              BigInt    @id @default(autoincrement())
  event_code      String    @db.Citext
  full_name       String    @db.Citext
  origin          String    @db.Citext
  category        String    @db.Citext
  custom_category String?   @db.Citext
  duplicate_hash  String    @db.Citext
  scan_payload    String?   @db.Citext
  device_id       String?   @db.Citext
  user_agent      String?   @db.Citext
  ip_address      String?   @db.Citext
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.Timestamp(0)

  @@unique([event_code, duplicate_hash], map: "unique_event_visitor")
  @@index([event_code, category], map: "idx_event_category")
  @@index([event_code, created_at], map: "idx_event_created")
