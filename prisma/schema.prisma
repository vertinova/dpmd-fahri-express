  nama_disk     String                    @unique(map: "uq_video_desa_kiriman_disk") @db.Citext
  jalur_disk    String @db.Citext
  status        video_desa_kiriman_status @default(masuk)
  pemrosesan    video_desa_kiriman_proses @default(antre)
  pesan_proses  String? @db.Citext
  catatan       String? @db.Citext
  ditinjau_oleh BigInt?
  ditinjau_pada DateTime? @db.Timestamp(0)
  ip            String? @db.Citext
  created_at    DateTime?                 @default(now()) @db.Timestamp(0)

  @@index([permintaan_id, created_at], map: "idx_video_desa_kiriman_permintaan")
  @@index([permintaan_id, desa_id], map: "idx_video_desa_kiriman_desa")
  @@index([pemrosesan], map: "idx_video_desa_kiriman_proses")
}

model video_desa_tautan {
