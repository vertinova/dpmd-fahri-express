  @@index([is_active], map: "informasi_idx_is_active")
  @@index([urutan], map: "idx_urutan")
  @@index([created_by], map: "informasi_idx_created_by")
}

model bidangs {
  id                       BigInt                     @id @default(autoincrement())
  nama                     String @db.Citext
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)
  anggaran_bidang_units    anggaran_bidang_units[]
  anggaran_master_kegiatan anggaran_master_kegiatan[]
  jadwal_kegiatan          jadwal_kegiatan[]
  jadwal_kegiatan_bidang   jadwal_kegiatan_bidang[]
  kegiatan_bidang          kegiatan_bidang[]
  pegawai                  pegawai[]
  pencairan                pencairan[]
  produk_hukum_bidang      produk_hukum_bidang[]
}

model anggaran_bidang_units {
  id                       BigInt                     @id @default(autoincrement())
  bidang_id                BigInt
  nama                     String @db.Citext
  kode                     String? @db.Citext
  urutan                   Int                        @default(1)
  created_at               DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(0)
  bidangs                  bidangs                    @relation(fields: [bidang_id], references: [id], onDelete: Cascade, map: "fk_anggaran_bidang_units_bidang")
  anggaran_master_kegiatan anggaran_master_kegiatan[]

  @@index([bidang_id], map: "anggaran_bidang_units_idx_bidang_id")
}

/// Master Kegiatan - data tetap, tidak berubah tiap tahun
model anggaran_master_kegiatan {
  id                BigInt                 @id @default(autoincrement())
  bidang_id         BigInt
  bidang_unit_id    BigInt?
  kode_program      String? @db.Citext
  nama_program      String @db.Citext
  kode_kegiatan     String? @db.Citext
  nama_kegiatan     String @db.Citext
  kode_sub_kegiatan String? @db.Citext
  nama_sub_kegiatan String? @db.Citext
  id_giat           Int?
  id_sub_giat       Int?
  urutan            Int                    @default(1)
  is_active         Boolean                @default(true)
  created_by        BigInt
  created_at        DateTime?              @default(now()) @db.Timestamp(0)
  updated_at        DateTime?              @default(now()) @db.Timestamp(0)
  bidangs           bidangs                @relation(fields: [bidang_id], references: [id], onDelete: Cascade, map: "fk_amk_bidang")
  bidang_unit       anggaran_bidang_units? @relation(fields: [bidang_unit_id], references: [id], map: "fk_amk_unit")
  users             users                  @relation("anggaran_master_kegiatan_created_by", fields: [created_by], references: [id], map: "fk_amk_user_fk")
  pagu_list         anggaran_pagu[]
  pencairan         pencairan[]

  @@index([bidang_id], map: "anggaran_master_kegiatan_idx_bidang_id")
  @@index([bidang_unit_id], map: "idx_bidang_unit_id")
  @@index([kode_kegiatan], map: "idx_kode_kegiatan")
  @@index([is_active], map: "anggaran_master_kegiatan_idx_is_active")
  @@index([created_by], map: "fk_amk_user")
}

/// Pagu per kegiatan per tahun - berubah setiap tahun
model anggaran_pagu {
  id                 BigInt                   @id @default(autoincrement())
  master_kegiatan_id BigInt
  tahun              Int
  pagu               Decimal                  @default(0.00) @db.Decimal(20, 2)
  pagu_indikatif     Decimal?                 @default(0.00) @db.Decimal(20, 2)
  created_by         BigInt
  created_at         DateTime?                @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                @default(now()) @db.Timestamp(0)
  master_kegiatan    anggaran_master_kegiatan @relation(fields: [master_kegiatan_id], references: [id], onDelete: Cascade, map: "fk_ap_master")
  users              users                    @relation("anggaran_pagu_created_by", fields: [created_by], references: [id], map: "fk_ap_user_fk")
  rka_items          anggaran_rka_items[]
