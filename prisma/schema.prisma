  memory     Decimal? @db.Decimal(5, 2)
  disk       Decimal? @db.Decimal(5, 2)
  load1      Decimal? @db.Decimal(8, 2)
  process_mb Int?
  requests   Int?
  errors     Int?
  avg_ms     Int?
  net_rx     BigInt?
  net_tx     BigInt?
  attacks    Int?
  online     Int?
