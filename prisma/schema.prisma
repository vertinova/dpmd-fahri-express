  tanda      String?   @db.Citext
  kalimat    String?   @db.Citext
  total      Int       @default(0)
  durasi_ms  Int       @default(0)
  nilai      Int       @default(0) @db.SmallInt
  dinilai_at DateTime? @db.Timestamp(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_gema_pertanyaan_created")
  @@index([tanda], map: "idx_gema_pertanyaan_tanda")
  @@index([user_id, created_at], map: "idx_gema_pertanyaan_user_created")
