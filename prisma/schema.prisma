  kecamatan_id      Int?
  desa_id           BigInt?
  user_id           BigInt?
  reporter_name     String    @db.Citext
  reporter_whatsapp String?   @db.Citext
  subject           String    @db.Citext
  status            String    @default("baru") @db.Citext
  priority          String    @default("normal") @db.Citext
  handled_by        BigInt?
