model gema_pertanyaan {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt?
  sesi       String?   @db.Citext
  teks       String    @db.Citext
  pola       String    @db.Citext
  ditenagai  String    @db.Citext
