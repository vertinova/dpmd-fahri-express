generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// Riwayat satu baris aparatur: dibuat, diubah, dan keputusan verifikasinya.
/// Tidak memakai `activity_logs` karena entity_id di sana BigInt sedangkan id
/// aparatur berupa UUID. Nama & peran pelaku disalin supaya riwayat tetap
/// terbaca kalau akunnya kelak dihapus.
model aparatur_desa_logs {
  id          BigInt    @id @default(autoincrement())
  aparatur_id String @db.Citext
  aksi        String @db.Citext
  keterangan  String? @db.Citext
  oleh_id     BigInt?
  oleh_nama   String? @db.Citext
  oleh_peran  String? @db.Citext
  created_at  DateTime? @default(now()) @db.Timestamp(0)

  @@index([aparatur_id, created_at], map: "aparatur_desa_logs_aparatur_id_index")
}

model activity_logs {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  user_name   String? @db.Citext
  user_role   String? @db.Citext
  bidang_id   BigInt?
  module      String @db.Citext
  action      String @db.Citext
  entity_type String @db.Citext
  entity_id   BigInt?
  entity_name String? @db.Citext
  description String @db.Citext
  old_value   Json?
  new_value   Json?
  ip_address  String? @db.Citext
  user_agent  String? @db.Citext
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "activity_logs_user_id_foreign")

  @@index([action], map: "idx_action")
  @@index([bidang_id], map: "activity_logs_idx_bidang_id")
  @@index([created_at], map: "activity_logs_idx_created_at")
  @@index([module], map: "idx_module")
  @@index([module, action], map: "idx_module_action")
  @@index([user_id], map: "activity_logs_idx_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model login_histories {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  ip_address  String? @db.Citext
  user_agent  String? @db.Citext
  device_id   String? @db.Citext
  device_type String? @db.Citext
  browser     String? @db.Citext
  os          String? @db.Citext
  status      String    @default("success") @db.Citext
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_login_histories_user_id")

  @@index([user_id], map: "idx_login_histories_user_id")
  @@index([created_at], map: "idx_login_histories_created_at")
  @@index([ip_address], map: "idx_login_histories_ip_address")
}

model aparatur_desa {
  id                         String                      @id @db.Citext
  desa_id                    BigInt
  nama_lengkap               String @db.Citext
  jabatan                    String @db.Citext
  nipd                       String? @db.Citext
  niap                       String? @db.Citext
  /// Wajib di formulir, NULL di sini: baris lama belum punya isinya.
  /// Lihat utils/aparaturIdentitas.js.
  nik                        String? @db.Citext
  /// Format wa.me: 62xxxxxxxxxx.
  whatsapp                   String? @db.Citext
  tempat_lahir               String @db.Citext
  tanggal_lahir              DateTime @db.Date
  /// Tanggal lahir masih taksiran impor Dapur Desa (1 Januari) — NIPD ditahan.
  tanggal_lahir_taksiran     Boolean                     @default(false)
  jenis_kelamin              aparatur_desa_jenis_kelamin
  pendidikan_terakhir        String @db.Citext
  agama                      String @db.Citext
  pangkat_golongan           String? @db.Citext
  tanggal_pengangkatan       DateTime @db.Date
  nomor_sk_pengangkatan      String @db.Citext
  tanggal_pemberhentian      DateTime? @db.Date
  nomor_sk_pemberhentian     String? @db.Citext
  keterangan                 String? @db.Citext
  status                     aparatur_desa_status        @default(Aktif)
  /// 'desa' = diisi sendiri oleh desa, 'dapur_desa' = hasil suntikan arsip Dapur Desa.
  sumber_data                String                      @default("desa") @db.Citext
  /// id record asal di arsip Dapur Desa; jalan pulang kalau impor perlu dibatalkan.
  dapur_id                   Int?
  produk_hukum_id            String? @db.Citext
  bpjs_kesehatan_nomor       String? @db.Citext
  bpjs_ketenagakerjaan_nomor String? @db.Citext
  file_bpjs_kesehatan        String? @db.Citext
  file_bpjs_ketenagakerjaan  String? @db.Citext
  file_pas_foto              String? @db.Citext
  file_ktp                   String? @db.Citext
  file_kk                    String? @db.Citext
  file_akta_kelahiran        String? @db.Citext
  file_ijazah_terakhir       String? @db.Citext
  /// SK jabatan terakhir — dasar verifikasi jabatan & penerbitan NIPD.
  file_sk_terakhir           String? @db.Citext
  /// Keputusan verifikasi oleh Bidang Pemerintahan Desa: 'terverifikasi' atau
  /// 'ditolak' (NULL = belum diperiksa). `dpmd_verified_at` adalah waktu
  /// keputusan, berlaku untuk kedua hasil, dan `catatan_verifikasi` adalah
  /// keterangan yang dibaca desa — wajib saat menolak.
  /// `dpmd_verified_by` sengaja tidak direlasikan ke `users`: nama pemutus
  /// diambil sekali saat detail dibuka.
  status_verifikasi          String? @db.Citext
  dpmd_verified_at           DateTime? @db.Timestamp(0)
  dpmd_verified_by           BigInt?
  catatan_verifikasi         String? @db.Citext
  /// Keputusan per kelompok data & per berkas: { item: { status, catatan, oleh, pada } }.
  /// Lihat utils/aparaturNipd.js → ITEM_VERIFIKASI.
  verifikasi_item            Json?
  created_at                 DateTime? @db.Timestamp(0)
  updated_at                 DateTime? @db.Timestamp(0)
  desas                      desas                       @relation(fields: [desa_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "aparatur_desa_desa_id_foreign_fk")
  produk_hukums              produk_hukums?              @relation(fields: [produk_hukum_id], references: [id], onUpdate: NoAction, map: "aparatur_desa_produk_hukum_id_foreign_fk")
  users                      users?

  @@index([nipd], map: "aparatur_desa_nipd_index")
  @@index([desa_id], map: "aparatur_desa_desa_id_foreign")
  @@index([produk_hukum_id], map: "aparatur_desa_produk_hukum_id_foreign")
  @@index([dapur_id], map: "aparatur_desa_dapur_id_index")
  @@index([nik], map: "aparatur_desa_nik_index")
}

/// Arsip aparatur dari Dapur Desa (integrasi API-nya sudah dimatikan, lihat
/// scripts/import-dapur-desa.js). Ditampung terpisah dan TIDAK langsung menimpa
/// `aparatur_desa`, supaya desa bisa memilih data mana yang dipakai saat bentrok.
model aparatur_dapur_desa {
  id                    BigInt    @id @default(autoincrement())
  /// id record asli di Dapur Desa; kunci idempoten saat impor diulang.
  dapur_id              Int       @unique(map: "aparatur_dapur_desa_dapur_id_unique")
  /// Hasil pemetaan kode desa ke tabel `desas`. NULL = kode tidak dikenali.
  desa_id               BigInt?
  kode_desa             String? @db.Citext
  kode_kecamatan        String? @db.Citext
  nama_desa_sumber      String? @db.Citext
  nama_kecamatan_sumber String? @db.Citext
  nama                  String @db.Citext
  /// Nama tanpa gelar/tanda baca, huruf besar — dipakai untuk mencocokkan dengan isian desa.
  nama_normal           String @db.Citext
  jabatan               String? @db.Citext
  jenis_kelamin         String? @db.Citext
  usia                  Int?
  agama                 String? @db.Citext
  status_kawin          String? @db.Citext
  status_pns            String? @db.Citext
  pendidikan            String? @db.Citext
  no_sk                 String? @db.Citext
  tgl_sk                DateTime? @db.Date
  no_sk_pertama         String? @db.Citext
  tgl_sk_pertama        DateTime? @db.Date
  tahun_lulus           String? @db.Citext
  foto_url              String? @db.Citext
  /// Path foto di arsip lokal; dipakai tahap kedua saat foto disalin ke server.
  foto_lokal            String? @db.Citext
  /// baru | otomatis | sama | konflik | selesai | ditolak | tanpa_desa
  status_rekonsiliasi   String    @default("baru") @db.Citext
  /// Record aparatur yang dicocokkan (konflik) atau yang dihasilkan (otomatis/selesai).
  aparatur_desa_id      String? @db.Citext
  /// dapur | desa — pilihan operator desa saat menyelesaikan konflik.
  keputusan             String? @db.Citext
  diputuskan_oleh       BigInt?
  diputuskan_pada       DateTime? @db.Timestamp(0)
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @default(now()) @db.Timestamp(0)

  @@index([desa_id], map: "aparatur_dapur_desa_desa_id_index")
  @@index([nama_normal], map: "aparatur_dapur_desa_nama_normal_index")
  @@index([status_rekonsiliasi], map: "aparatur_dapur_desa_status_index")
}

model app_settings {
  id                 Int       @id @default(autoincrement())
  setting_key        String    @unique @db.Citext
  setting_value      String @db.Citext
  description        String? @db.Citext
  updated_by_user_id BigInt?
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  users              users?    @relation(fields: [updated_by_user_id], references: [id], map: "fk_app_settings_user")

  @@index([updated_by_user_id], map: "fk_app_settings_user_idx")
  @@index([setting_key], map: "idx_setting_key")
}

model bankeu_master_kegiatan {
  id                       Int                                   @id @default(autoincrement()) @db.SmallInt
  jenis_kegiatan           bankeu_master_kegiatan_jenis_kegiatan
  urutan                   Int @db.SmallInt
  nama_kegiatan            String @db.Citext
  dinas_terkait            String? @db.Citext
  is_active                Boolean?                              @default(true)
  created_at               DateTime?                             @default(now()) @db.Timestamp(0)
  bankeu_proposal_kegiatan bankeu_proposal_kegiatan[]
  berita_acara_history     berita_acara_history[]

  @@index([dinas_terkait], map: "idx_dinas_terkait")
  @@index([jenis_kegiatan], map: "bankeu_master_kegiatan_idx_jenis")
}

model bankeu_proposal_2025 {
  id             BigInt   @id @default(autoincrement())
  desa_id        BigInt
  tahun_anggaran Int      @default(2025) @db.Integer
  nama_file      String @db.Citext
  file_path      String @db.Citext
  file_size      Int? @db.Integer
  keterangan     String? @db.Citext
  uploaded_by    BigInt
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @db.Timestamp(0)
  desas          desas    @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_bankeu_proposal_2025_desa")
  users          users    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade, map: "fk_bankeu_proposal_2025_user")

  @@index([desa_id], map: "idx_bankeu_proposal_2025_desa_id")
  @@index([tahun_anggaran], map: "idx_bankeu_proposal_2025_tahun")
  @@index([desa_id, tahun_anggaran], map: "idx_bankeu_proposal_2025_desa_tahun")
  @@index([uploaded_by], map: "idx_bankeu_proposal_2025_uploaded_by")
}

model bankeu_proposal_kegiatan {
  id                     BigInt                 @id @default(autoincrement())
  proposal_id            BigInt
  kegiatan_id            Int @db.SmallInt
  created_at             DateTime?              @default(now()) @db.Timestamp(0)
  bankeu_master_kegiatan bankeu_master_kegiatan @relation(fields: [kegiatan_id], references: [id], onDelete: Cascade, map: "fk_proposal_kegiatan_kegiatan")
  bankeu_proposals       bankeu_proposals       @relation(fields: [proposal_id], references: [id], onDelete: Cascade, map: "fk_proposal_kegiatan_proposal")

  @@unique([proposal_id, kegiatan_id], map: "unique_proposal_kegiatan")
  @@index([kegiatan_id], map: "idx_kegiatan_id")
  @@index([proposal_id], map: "bankeu_proposal_kegiatan_idx_proposal_id")
}

model bankeu_lpj {
  id               BigInt            @id @default(autoincrement())
  desa_id          BigInt
  tahun_anggaran   Int               @default(2025) @db.Integer
  nama_file        String @db.Citext
  file_path        String @db.Citext
  file_size        Int? @db.Integer
  keterangan       String? @db.Citext
  uploaded_by      BigInt
  created_at       DateTime          @default(now()) @db.Timestamp(0)
  updated_at       DateTime          @default(now()) @db.Timestamp(0)
  dpmd_catatan     String? @db.Citext
  dpmd_verified_at DateTime? @db.Timestamp(0)
  dpmd_verified_by BigInt?
  status           bankeu_lpj_status @default(pending)
  desas            desas             @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_bankeu_lpj_desa")
  users            users             @relation(fields: [uploaded_by], references: [id], onDelete: Cascade, map: "fk_bankeu_lpj_user_fk")

  @@index([desa_id, tahun_anggaran], map: "idx_bankeu_lpj_desa_tahun")
  @@index([desa_id], map: "idx_bankeu_lpj_desa_id")
  @@index([tahun_anggaran], map: "idx_bankeu_lpj_tahun")
  @@index([status], map: "idx_bankeu_lpj_status")
  @@index([uploaded_by], map: "fk_bankeu_lpj_user")
}

model bankeu_lpj_video {
  id               BigInt   @id @default(autoincrement())
  desa_id          BigInt
  tahun_anggaran   Int @db.Integer
  dayeuh_pajajaran Json
  infrastruktur    Json
  updated_by       BigInt
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @db.Timestamp(0)
  desas            desas    @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_bankeu_lpj_video_desa")

  @@unique([desa_id, tahun_anggaran], map: "uq_bankeu_lpj_video_desa_tahun")
}

model bankeu_lpj_sts {
  id             BigInt   @id @default(autoincrement())
  desa_id        BigInt
  tahun_anggaran Int @db.Integer
  nominal        BigInt
  tanggal_setor  DateTime @db.Date
  nama_file      String @db.Citext
  file_path      String @db.Citext
  file_size      Int? @db.Integer
  uploaded_by    BigInt
  created_at     DateTime @default(now()) @db.Timestamp(0)
  desas          desas    @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_bankeu_lpj_sts_desa")
  users          users    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade, map: "fk_bankeu_lpj_sts_user_fk")

  @@index([desa_id, tahun_anggaran], map: "idx_bankeu_lpj_sts_desa_tahun")
  @@index([uploaded_by], map: "fk_bankeu_lpj_sts_user")
}

model bantuan_provinsi_lpj {
  id                                                 BigInt                      @id @default(autoincrement())
  desa_id                                            BigInt
  tahun_anggaran                                     Int                         @default(2026) @db.Integer
  nama_file                                          String @db.Citext
  file_path                                          String @db.Citext
  file_size                                          Int? @db.Integer
  keterangan                                         String? @db.Citext
  status                                             bantuan_provinsi_lpj_status @default(pending)
  dpmd_catatan                                       String? @db.Citext
  dpmd_verified_by                                   BigInt?
  dpmd_verified_at                                   DateTime? @db.Timestamp(0)
  uploaded_by                                        BigInt
  created_at                                         DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                                         DateTime                    @default(now()) @db.Timestamp(0)
  desas                                              desas                       @relation(fields: [desa_id], references: [id], onDelete: Cascade, map: "fk_bantuan_provinsi_lpj_desa")
  users_bantuan_provinsi_lpj_uploaded_byTousers      users                       @relation("bantuan_provinsi_lpj_uploaded_by", fields: [uploaded_by], references: [id], onDelete: Cascade, map: "fk_bantuan_provinsi_lpj_user")
  users_bantuan_provinsi_lpj_dpmd_verified_byTousers users?                      @relation("bantuan_provinsi_lpj_dpmd_verified_by", fields: [dpmd_verified_by], references: [id], map: "fk_bantuan_provinsi_lpj_verified_by")

  @@index([desa_id], map: "idx_bantuan_provinsi_lpj_desa_id")
  @@index([tahun_anggaran], map: "idx_bantuan_provinsi_lpj_tahun")
  @@index([status], map: "idx_bantuan_provinsi_lpj_status")
  @@index([uploaded_by], map: "idx_bantuan_provinsi_lpj_uploaded_by")
  @@index([dpmd_verified_by], map: "idx_bantuan_provinsi_lpj_verified_by")
}

model bankeu_proposals {
  id                                                  BigInt                               @id @default(autoincrement())
  desa_id                                             BigInt
  kegiatan_id                                         Int? @db.SmallInt
  judul_proposal                                      String @db.Citext
  nama_kegiatan_spesifik                              String? @db.Citext
  volume                                              String? @db.Citext
  lokasi                                              String? @db.Citext
  deskripsi                                           String? @db.Citext
  file_proposal                                       String @db.Citext
  surat_pengantar                                     String? @db.Citext
  surat_permohonan                                    String? @db.Citext
  dinas_reviewed_file                                 String? @db.Citext
  dinas_reviewed_at                                   DateTime? @db.Timestamp(0)
  file_size                                           Int? @db.Integer
  anggaran_usulan                                     Decimal? @db.Decimal(15, 2)
  status                                              bankeu_proposals_status?             @default(pending)
  dinas_status                                        bankeu_proposals_dinas_status?
  submitted_to_dinas_at                               DateTime? @db.Timestamp(0)
  dinas_verified_at                                   DateTime? @db.Timestamp(0)
  dinas_verified_by                                   Int?
  dinas_catatan                                       String? @db.Citext
  kecamatan_status                                    bankeu_proposals_kecamatan_status?
  kecamatan_catatan                                   String? @db.Citext
  kecamatan_verified_at                               DateTime? @db.Timestamp(0)
  kecamatan_verified_by                               BigInt?
  dpmd_status                                         bankeu_proposals_dpmd_status?
  dpmd_catatan                                        String? @db.Citext
  dpmd_verified_at                                    DateTime? @db.Timestamp(0)
  dpmd_verified_by                                    BigInt?
  submitted_to_kecamatan                              Boolean?                             @default(false)
  submitted_at                                        DateTime? @db.Timestamp(0)
  submitted_to_dpmd                                   Boolean?                             @default(false)
  submitted_to_dpmd_at                                DateTime? @db.Timestamp(0)
  catatan_verifikasi                                  String? @db.Citext
  verified_by                                         BigInt?
  verified_at                                         DateTime? @db.Timestamp(0)
  berita_acara_path                                   String? @db.Citext
  berita_acara_generated_at                           DateTime? @db.Timestamp(0)
  created_by                                          BigInt
  created_at                                          DateTime?                            @default(now()) @db.Timestamp(0)
  updated_at                                          DateTime?                            @default(now()) @db.Timestamp(0)
  tahun_anggaran                                      Int                                  @default(2026) @db.Integer
  troubleshoot_catatan                                String? @db.Citext
  troubleshoot_by                                     BigInt?
  troubleshoot_at                                     DateTime? @db.Timestamp(0)
  bankeu_proposal_kegiatan                            bankeu_proposal_kegiatan[]
  users_bankeu_proposals_dpmd_verified_byTousers      users?                               @relation("bankeu_proposals_dpmd_verified_byTousers", fields: [dpmd_verified_by], references: [id], onUpdate: NoAction, map: "fk_bankeu_dpmd_verified_by")
  users_bankeu_proposals_kecamatan_verified_byTousers users?                               @relation("bankeu_proposals_kecamatan_verified_byTousers", fields: [kecamatan_verified_by], references: [id], onUpdate: NoAction, map: "fk_bankeu_kecamatan_verified_by")
  users_bankeu_proposals_created_byTousers            users                                @relation("bankeu_proposals_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bankeu_proposals_created_by")
  desas                                               desas                                @relation(fields: [desa_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bankeu_proposals_desa")
  users_bankeu_proposals_verified_byTousers           users?                               @relation("bankeu_proposals_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction, map: "fk_bankeu_proposals_verified_by")
  users_bankeu_proposals_troubleshoot_byTousers       users?                               @relation("bankeu_proposals_troubleshoot_byTousers", fields: [troubleshoot_by], references: [id], onUpdate: NoAction, map: "fk_bankeu_troubleshoot_by")
  bankeu_verification_questionnaires                  bankeu_verification_questionnaires[]
  berita_acara_history                                berita_acara_history[]

  @@index([created_by], map: "bankeu_proposals_idx_created_by")
  @@index([desa_id], map: "idx_desa")
  @@index([dinas_status], map: "idx_dinas_status")
  @@index([dinas_verified_by], map: "idx_dinas_verified_by")
  @@index([dpmd_status], map: "idx_dpmd_status")
  @@index([dpmd_verified_by], map: "idx_dpmd_verified_by")
  @@index([kecamatan_status], map: "bankeu_proposals_idx_kecamatan_status")
  @@index([kecamatan_verified_by], map: "idx_kecamatan_verified_by")
  @@index([status], map: "bankeu_proposals_idx_status")
  @@index([submitted_to_dpmd], map: "idx_submitted_to_dpmd")
  @@index([submitted_to_kecamatan], map: "idx_submitted_to_kecamatan")
  @@index([troubleshoot_by], map: "idx_troubleshoot_by")
  @@index([verified_by], map: "idx_verified_by")
}

model bankeu_verification_questionnaires {
  id                       BigInt                                                     @id @default(autoincrement())
  proposal_id              BigInt
  tim_verifikasi_id        BigInt?
