// ============================================================
// Drive per bidang
// ============================================================
// Berkasnya disimpan di storage/private/drive (di luar jangkauan
// express.static) dan hanya bisa diambil lewat controller yang memeriksa izin.

model drive_folder {
  id         BigInt    @id @default(autoincrement())
  bidang_id  BigInt
  parent_id  BigInt?
  nama       String @db.Citext
  jalur      String    @default("/") @db.Citext
  created_by BigInt?
  updated_by BigInt?
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  deleted_by BigInt?

  @@index([bidang_id, parent_id, deleted_at], map: "idx_drive_folder_bidang")
  @@index([deleted_at], map: "idx_drive_folder_sampah")
}

model drive_file {
  id         BigInt    @id @default(autoincrement())
  bidang_id  BigInt
  folder_id  BigInt?
  nama       String @db.Citext
  nama_asli  String @db.Citext
  mime       String? @db.Citext
  ekstensi   String? @db.Citext
  ukuran     BigInt    @default(0)
  nama_disk  String    @unique(map: "uq_drive_file_disk") @db.Citext
  jalur_disk String @db.Citext
  checksum   String? @db.Citext
  created_by BigInt?
  updated_by BigInt?
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  deleted_by BigInt?

  @@index([bidang_id, folder_id, deleted_at], map: "idx_drive_file_bidang")
  @@index([bidang_id, checksum], map: "idx_drive_file_checksum")
  @@index([deleted_at], map: "idx_drive_file_sampah")
}

model drive_share {
  id             BigInt                    @id @default(autoincrement())
  objek_tipe     drive_share_objek_tipe
  objek_id       BigInt
  bidang_pemilik BigInt
  penerima_tipe  drive_share_penerima_tipe
  penerima_id    BigInt
  izin           drive_share_izin          @default(lihat)
  created_by     BigInt?
  created_at     DateTime?                 @default(now()) @db.Timestamp(0)

  @@unique([objek_tipe, objek_id, penerima_tipe, penerima_id], map: "uq_drive_share")
  @@index([penerima_tipe, penerima_id], map: "idx_drive_share_penerima")
  @@index([objek_tipe, objek_id], map: "idx_drive_share_objek")
}

model drive_kuota {
  bidang_id      BigInt    @id
  batas_bytes    BigInt    @default(26843545600)
  terpakai_bytes BigInt    @default(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
}

enum drive_share_objek_tipe {
  folder
  file
}

enum drive_share_penerima_tipe {
  bidang
  user
}

enum drive_share_izin {
  lihat
  ubah
}

// ============================================================
// Formulir (pembuat formulir mandiri per bidang)
// ============================================================
// Lampiran jawaban disimpan di private/formulir (di luar jangkauan
// express.static) dan hanya bisa diambil lewat controller yang memeriksa izin.

model formulir {
  id               BigInt          @id @default(autoincrement())
  bidang_id        BigInt
  judul            String @db.Citext
  deskripsi        String? @db.Citext
  token            String          @unique(map: "uq_formulir_token") @db.Citext
  status           formulir_status @default(draf)
  butuh_login      Boolean         @default(false)
  satu_respons     Boolean         @default(false)
  kumpulkan_email  Boolean         @default(false)
  acak_pertanyaan  Boolean         @default(false)
  respons_terbuka  Boolean         @default(false)
  pesan_konfirmasi String? @db.Citext
  tutup_pada       DateTime? @db.Timestamp(0)
  batas_respons    Int? @db.Integer
  created_by       BigInt?
  updated_by       BigInt?
  created_at       DateTime?       @default(now()) @db.Timestamp(0)
  updated_at       DateTime?       @default(now()) @db.Timestamp(0)
  deleted_at       DateTime? @db.Timestamp(0)
  deleted_by       BigInt?

  @@index([bidang_id, deleted_at], map: "idx_formulir_bidang")
  @@index([status, deleted_at], map: "idx_formulir_status")
}

model formulir_pertanyaan {
  id          BigInt                   @id @default(autoincrement())
  formulir_id BigInt
  tipe        formulir_pertanyaan_tipe @default(jawaban_singkat)
  label       String @db.Citext
  deskripsi   String? @db.Citext
  wajib       Boolean                  @default(false)
  urutan      Int                      @default(0)
  opsi        Json?
  pengaturan  Json?
  created_at  DateTime?                @default(now()) @db.Timestamp(0)
  updated_at  DateTime?                @default(now()) @db.Timestamp(0)

  @@index([formulir_id, urutan], map: "idx_formulir_pertanyaan_urut")
}

model formulir_respons {
  id             BigInt    @id @default(autoincrement())
  formulir_id    BigInt
  user_id        BigInt?
  nama_responden String? @db.Citext
  email          String? @db.Citext
  ip             String? @db.Citext
  dikirim_pada   DateTime? @default(now()) @db.Timestamp(0)

  @@index([formulir_id, dikirim_pada], map: "idx_formulir_respons_form")
  @@index([formulir_id, user_id], map: "idx_formulir_respons_user")
}

model formulir_jawaban {
