# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dpmd
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql://root:@localhost:3306/dpmd

# JWT Configuration (use same key as Laravel APP_KEY for compatibility)
JWT_SECRET=base64:vpA3CHUtaAUuSW8XJFH+6wLrwAaz7VCJC99ofWGffUE=
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./storage/uploads

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Base URL publik aplikasi (dipakai untuk link download & QR arsip barang).
# PENTING: QR arsip barang yang sudah dicetak & ditempel di barang memuat URL ini
# secara permanen — mengubahnya membuat label lama tidak bisa discan lagi.
# Development: http://localhost:5173
# Production:  https://dpmd.bogorkab.go.id
BASE_URL=http://localhost:5173

# Video Meeting / Mediasoup Configuration
# CRITICAL: Set this to your server's PUBLIC IP address for video meetings to work!
# For development (same machine): 127.0.0.1
# For production: the server's public IP (e.g., 103.51.103.74)
# Without this, remote participants won't be able to see each other's video
# Development:
# MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# Production (VPS dpmd.bogorkab.go.id):
MEDIASOUP_ANNOUNCED_IP=103.51.103.74

# External DPMD API / Dapur Desa (Proxy Pattern) — NONAKTIF sejak 23 Juli 2026.
# Sistem lama dipensiunkan dan alamatnya (dpmd.bogorkab.go.id) kini dipakai
# aplikasi ini sendiri, jadi jangan diisi dengan domain tersebut — backend akan
# memanggil dirinya sendiri. Data aparatur di-restore dari backup ke DB lokal.
# Biarkan kosong agar integrasi mati; isi ketiganya untuk mengaktifkan kembali.
EXTERNAL_DPMD_API_URL=
EXTERNAL_DPMD_USERNAME=
EXTERNAL_DPMD_PASSWORD=

# SIPANDA (penyaluran dana desa: ADD, DD, BHPRD) — dipakai core-dashboard keuangan_desa
# SIPANDA_TAHUN WAJIB di-bump tiap tahun anggaran (URL SIPANDA per-tahun).
SIPANDA_TAHUN=2026
SIPANDA_BASE_URL=https://sipanda-bogorkab.smartvillage.info
SIPANDA_TIMEOUT_MS=12000
SIPANDA_TTL_MS=300000

# Core Dashboard Open API
# Wajib diisi minimal 32 karakter acak. Kirim via header: x-api-key atau Authorization: Bearer <key>
CORE_DASHBOARD_API_KEY=replace-with-random-32-plus-character-api-key

# ── Gema: asisten suara Core Dashboard ──────────────────────────────────────
#
# Model bahasa lokal (llama-server, OpenAI-compatible, CT 108). GEMA_LLM_URL
# KOSONG = Gema memakai mesin kata kunci saja dan tidak ada yang dikirim ke mana pun.
# Model hanya melihat hasil alat yang ia panggil; angka & tabel selalu dari basis data.
GEMA_LLM_URL=
GEMA_LLM_KEY=
GEMA_LLM_MODEL=gemma-4-26b-a4b
# Server suara (TTS) untuk endpoint /api/gema/suara; kosong = suara server nonaktif.
GEMA_TTS_URL=
GEMA_TTS_KEY=
# Akses baca SQL untuk alat kueri_data: pakai user DB READ-ONLY (gema_ro), mis.
# mysql://gema_ro:sandi@localhost:3306/dpmd. Kosong = alat kueri_data nonaktif.
GEMA_DB_URL=

# ── Helpdesk: AI penyusun jawaban chatbot & draf balasan petugas ──
# OpenAI-compatible; bawaannya Groq (kunci gratis di console.groq.com, buat kunci
# KHUSUS DPMD — kuota gratis dihitung per kunci & per model). Kosong = bot tetap
# menjawab dari FAQ dan data resmi tanpa AI. Yang dikirim ke penyedia: pertanyaan
# penanya, FAQ yang relevan, dan potongan data resmi yang relevan.
HELPDESK_AI_API_KEY=
HELPDESK_AI_BASE_URL=https://api.groq.com/openai/v1
HELPDESK_AI_MODEL=qwen/qwen3.8-27b
HELPDESK_AI_MODEL_CADANGAN=openai/gpt-oss-120b

# Lokasi mysqldump untuk fitur pencadangan superadmin (unduh .sql + berkas).
# Linux/VPS: biasanya cukup "mysqldump" karena sudah ada di PATH.
# Windows/Laragon: WAJIB jalur lengkap, mysqldump tidak ada di PATH. Contoh:
#   MYSQLDUMP_PATH=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe
MYSQLDUMP_PATH=mysqldump

# ASTA DESA — sumber halaman Core Dashboard "Asta Desa" (read-only).
# WAJIB akun ber-role super_admin di ASTA DESA; role lain ditolak 403 oleh
# endpoint /api/v1/admin di sana. Backend yang login dan menyimpan tokennya di
# memori — token super_admin tidak boleh sampai ke browser.
ASTADESA_IDENTITY=
ASTADESA_PASSWORD=
# Alternatif: token Sanctum langsung (login dilewati bila diisi).
ASTADESA_TOKEN=
ASTADESA_BASE_URL=https://astadesa.rmlabs.id/api/v1
ASTADESA_TIMEOUT_MS=20000
ASTADESA_TTL_MS=600000
ASTADESA_MAX_ROWS=20000

# API key untuk /api/eksternal/asta-desa — API yang diserahkan ke pihak Bupati.
# Kosong = endpointnya mati (balas 503), itulah keadaan bawaannya. Mencabut
# akses pihak Bupati = kosongkan baris ini lalu jalankan ulang backend; tidak
# perlu menyentuh token ASTA DESA maupun CORE_DASHBOARD_API_KEY.
# Minimal 32 karakter, dan JANGAN memuat kata "secret"/"password"/"replace_with"
# — penjaganya menolak kunci seperti itu sebagai kunci contoh yang belum diganti.
# Terbitkan dengan: openssl rand -hex 32
ASTADESA_BUPATI_API_KEY=

# -- Smart CCTV ---------------------------------------------------------------
# API key untuk layanan AI (Facial-recognition-cctv) mengambil daftar kamera &
# embedding wajah: Authorization: Bearer <CCTV_SERVICE_API_KEY>.
# Buat dengan: openssl rand -hex 32
CCTV_SERVICE_API_KEY=
# Token injeksi peristiwa deteksi (header X-Internal-Token). WAJIB diisi supaya
# endpoint /api/smart-cctv/internal/* tidak balas 503. Buat dengan: openssl rand -hex 32
CCTV_INTERNAL_TOKEN=
# Alamat go2rtc & layanan AI setempat (sinkron stream & test koneksi).
GO2RTC_URL=http://127.0.0.1:1984
PYTHON_AI_URL=http://127.0.0.1:8001
# Pembanding: dashboard Laravel (dashboard-face-recognition) yang tetap paralel.
# Diisi (mis. http://localhost:8000/api) = tiap peristiwa deteksi ikut
# diteruskan ke sana agar dashboard lama selalu menampilkan data yang sama.
CCTV_MIRROR_LARAVEL_URL=
CCTV_MIRROR_LARAVEL_TOKEN=
