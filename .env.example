# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dpmd
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql://root:@localhost:3306/dpmd

# JWT Configuration (use same key as Laravel APP_KEY for compatibility)
JWT_SECRET=base64:vpA3CHUtaAUuSW8XJFH+6wLrwAaz7VCJC99ofWGffUE=
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./storage/uploads

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Base URL publik aplikasi (dipakai untuk link download & QR arsip barang).
# PENTING: QR arsip barang yang sudah dicetak & ditempel di barang memuat URL ini
# secara permanen — mengubahnya membuat label lama tidak bisa discan lagi.
# Development: http://localhost:5173
# Production:  https://dpmd.bogorkab.go.id
BASE_URL=http://localhost:5173

# Video Meeting / Mediasoup Configuration
# CRITICAL: Set this to your server's PUBLIC IP address for video meetings to work!
# For development (same machine): 127.0.0.1
# For production: the server's public IP (e.g., 103.51.103.74)
# Without this, remote participants won't be able to see each other's video
# Development:
# MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# Production (VPS dpmd.bogorkab.go.id):
MEDIASOUP_ANNOUNCED_IP=103.51.103.74

# External DPMD API / Dapur Desa (Proxy Pattern) — NONAKTIF sejak 23 Juli 2026.
# Sistem lama dipensiunkan dan alamatnya (dpmd.bogorkab.go.id) kini dipakai
# aplikasi ini sendiri, jadi jangan diisi dengan domain tersebut — backend akan
# memanggil dirinya sendiri. Data aparatur di-restore dari backup ke DB lokal.
# Biarkan kosong agar integrasi mati; isi ketiganya untuk mengaktifkan kembali.
EXTERNAL_DPMD_API_URL=
EXTERNAL_DPMD_USERNAME=
EXTERNAL_DPMD_PASSWORD=

# SIPANDA (penyaluran dana desa: ADD, DD, BHPRD) — dipakai core-dashboard keuangan_desa
# SIPANDA_TAHUN WAJIB di-bump tiap tahun anggaran (URL SIPANDA per-tahun).
SIPANDA_TAHUN=2026
SIPANDA_BASE_URL=https://sipanda-bogorkab.smartvillage.info
SIPANDA_TIMEOUT_MS=12000
SIPANDA_TTL_MS=300000

# Core Dashboard Open API
# Wajib diisi minimal 32 karakter acak. Kirim via header: x-api-key atau Authorization: Bearer <key>
CORE_DASHBOARD_API_KEY=replace-with-random-32-plus-character-api-key
